root = true

[*]
charset = utf-8-bom
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{xml,csproj,wixproj,config,props,xaml,yml}]
indent_size = 2

[*.md]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = false

[*.{json,yml}]
charset = utf-8
end_of_line = lf

[*.cmd]
charset = utf-8
end_of_line = crlf

[.editorconfig]
charset = utf-8
end_of_line = lf

[.gitattributes]
charset = utf-8
end_of_line = lf
