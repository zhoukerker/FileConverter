# 文本统一存储为 LF；Windows 源码和构建脚本检出为 CRLF。
* text=auto
*.cs text eol=crlf
*.csproj text eol=crlf
*.wixproj text eol=crlf
*.wxs text eol=crlf
*.xaml text eol=crlf
*.xml text eol=crlf
*.resx text eol=crlf
*.config text eol=crlf
*.props text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
